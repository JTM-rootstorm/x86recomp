# xbox360_runtime_content: the packages tests/title left on the hard disk
# (title id 0: its XEX gives none).
set(_user "${DIR}/E000000000000001/00000000/00000001")
set(_none "${DIR}/0000000000000000/00000000/00000001")
foreach(_pair "${_user}/slot1/game.dat;5" "${_user}/slot1.header;316" "${_none}/common.header;316")
  list(GET _pair 0 _file)
  list(GET _pair 1 _size)
  if(NOT EXISTS "${_file}")
    message(FATAL_ERROR "${_file} was not saved")
  endif()
  file(SIZE "${_file}" _got)
  if(NOT _got EQUAL _size)
    message(FATAL_ERROR "${_file} is ${_got} bytes, not ${_size}")
  endif()
endforeach()
foreach(_gone "${_user}/slot2" "${_user}/slot2.header")
  if(EXISTS "${_gone}")
    message(FATAL_ERROR "${_gone} was deleted, but is there")
  endif()
endforeach()
